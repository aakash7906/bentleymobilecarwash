rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'bentleymobilecarwash@gmail.com' ||
        request.auth.token.email == 'support@bentleycarwash.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users & Customer Profiles
    match /users/{userId} {
      // Users can only view and edit their own profile; admins can view customer details
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Saved Vehicles
      match /vehicles/{vehicleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Bookings Collection (Zero Public Leaks)
    match /bookings/{bookingId} {
      // Customers can ONLY read their own bookings. Admins can view available requests & assigned jobs.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() ||
        resource.data.status == 'pending'
      );
      // Customers can create their own bookings
      allow create: if isAuthenticated() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid
      );
      // Customers can cancel/rate, Admins can accept/update status & live GPS
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      // Allow account deletion cleanup for owner
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // 3. Shop Orders Collection
    match /orders/{orderId} {
      // Customers can ONLY read their own orders. Admins can view pending dispatches & assigned deliveries.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() ||
        resource.data.status == 'pending'
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // 4. Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        !('userId' in resource.data) ||
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 5. Contact Inquiries (Allows public to contact support without login)
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }
  }
}
